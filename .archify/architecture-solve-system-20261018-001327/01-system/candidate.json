  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime ownership",
      "items": [
        "The lower service boxes are modules of one FastAPI process, not separate deployed workers.",
        "Study orchestration, grading, budgets and FSRS recall run in backend/main.py.",
        "Chat, goals, cards, history, exports and feedback are installed by backend/product.py."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence and privacy",
      "items": [
        "Database selection is environment driven. The adapter attempts PostgreSQL when configured and contains a SQLite fallback.",
        "Sessions, operations, accounts, conversations, messages and records share the selected database.",
        "Owner checks protect state and private files. No Redis integration is present in the inspected source."
      ]
    },
    {
      "dot": "amber",
      "title": "Configured capabilities",
      "items": [
        "Provider selection follows environment configuration; chat uses a separate streaming path.",
        "Google sign-in, speech and browser push require their respective service configuration.",
        "Animation jobs use an in-process queue: one renderer, at most eight jobs, four minutes per render."
      ]
    }
  ]
