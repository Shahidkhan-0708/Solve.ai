  "cards": [
    {
      "dot": "cyan",
      "title": "Context and assistance",
      "items": [
        "Context includes bounded saved history, extracted attachments, preferences and selected passages from an owned linked learning session.",
        "The first reply chunk marks a linked active study task as assisted. Chat help cannot silently establish independent learning evidence.",
        "Visual diagrams, response animations, exports and feedback act on owned conversation records; see the media map for rendering."
      ]
    },
    {
      "dot": "emerald",
      "title": "Saved before streaming",
      "items": [
        "The request and empty generating reply are committed before the SSE response starts. Every partial text update is saved.",
        "Completed operation IDs replay; interrupted IDs require a new regeneration operation. A second generating reply is rejected.",
        "Startup converts abandoned generating messages to interrupted. Failures preserve the learner question and available partial answer."
      ]
    },
    {
      "dot": "slate",
      "title": "Reading continuation boxes",
      "items": [
        "A box tagged Continue repeats an existing named step. It represents a return or handoff to that step, not a new service or a separate task.",
        "The vertical path shows one successful route; labeled branches preserve the other conditions and recovery actions."
      ]
    }
  ]
