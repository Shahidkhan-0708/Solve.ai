  "cards": [
    {
      "dot": "cyan",
      "title": "Storage and fallback",
      "items": [
        "Study uploads retain extracted passages. Conversation attachments and audio also retain private files with database metadata.",
        "Groq transcription falls back to structured extraction on the paths coded in media.py; speech generation requires Gemini.",
        "Speech reuses matching unexpired owned files. Expired audio/media is cleaned by the reminder dispatcher."
      ]
    },
    {
      "dot": "amber",
      "title": "What animation checks establish",
      "items": [
        "Storyboards use fixed card/dot/bar objects and literal evidence. The renderer executes a fixed Python script, not model-generated code.",
        "Lesson animation uses approved source passages. Conversation animation uses the AI reply as its cited input; it is not independent source verification.",
        "Text remains available on failure. Session deletion cancels its jobs and removes its generated clips; restart makes interrupted jobs retryable."
      ]
    }
  ]
