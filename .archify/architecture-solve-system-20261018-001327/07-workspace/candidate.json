  "cards": [
    {
      "dot": "cyan",
      "title": "Evidence stays separate",
      "items": [
        "Goal check-offs are explicit learner actions. Flashcard history and milestone completion do not fabricate study-session mastery.",
        "Roadmap validation retains completed milestones and rejects proposed weeks/hours outside the available budget.",
        "Uncertain flashcard assessment saves feedback without changing its recall schedule."
      ]
    },
    {
      "dot": "emerald",
      "title": "Record lifecycle and delivery",
      "items": [
        "Profiles and workspace records use ownership checks and revisions; history supports archive/restore, export and deletion.",
        "Push also needs browser permission and a stored subscription. Failed subscriptions returning 404/410 are removed.",
        "Dispatch limits a reminder to three attempts at least five minutes apart; reminders are explicitly created, not automatically derived from every recall date.",
        "Sign-out revokes its auth session. Guest-data migration runs only when claim_guest is explicitly requested."
      ]
    }
  ]
