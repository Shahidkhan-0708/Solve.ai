  "cards": [
    {
      "dot": "cyan",
      "title": "Progress rules",
      "items": [
        "Correct diagnostic/repair leads to teach-back when available, then independent practice. Correct teach-back or assisted work still needs an independent application.",
        "Only correct unassisted application establishes demonstrated evidence; a correct due review establishes rechecked evidence.",
        "Wrong/partial review schedules Again. An uncertain judgment retains the task and review schedule; logged time and the attempt are still saved."
      ]
    },
    {
      "dot": "emerald",
      "title": "Recovery and priority",
      "items": [
        "Current/pending work is preserved. Ready prerequisites, chosen topic, due review, confirmed gaps and supplied marks influence ordering.",
        "The server commits the grade before generating the next question. Operation IDs allow retry recovery without charging or grading the same answer twice.",
        "An existing repair question is retained after another failed repair. New questions reuse unseen material before calling AI."
      ]
    },
    {
      "dot": "slate",
      "title": "Reading continuation boxes",
      "items": [
        "A box tagged Continue repeats an existing named step. It represents a return or handoff to that step, not a new service or a separate task.",
        "The vertical path shows one successful route; labeled branches preserve the other conditions and recovery actions."
      ]
    }
  ]
