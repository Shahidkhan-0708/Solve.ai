API_URL=http://127.0.0.1:8000
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3002,http://localhost:3002
SOLVE_ORIGIN=http://127.0.0.1:3000
SECURE_COOKIES=false
MAX_AI_CALLS_PER_DAY=200

# Supabase PostgreSQL Database Connection
# You can copy the connection string from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use the connection pooler (port 6543) or direct connection (port 5432):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Project Credentials (optional, for client or storage integrations)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google identity remains disabled until a web client and authorized origins are configured.
GOOGLE_CLIENT_ID=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Opt-in browser push; generate your own VAPID key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
